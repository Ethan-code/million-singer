{
  "name": "million-singer",
  "version": "2.0.0",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "package": "electron-builder --dir",
    "build:win": "electron-builder --win --x64 -p never",
    "build:mac": "electron-builder --mac --x64 -p never",
    "build:linux": "electron-builder --linux AppImage -p never",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.ethan.millionstar",
    "productName": "百萬大歌星",
    "files": [
      "main/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "samples/",
        "to": "samples/"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": false
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.4.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "百萬大歌星：歌詞遮字接唱遊戲",
  "dependencies": {
    "opencc-js": "^1.4.2",
    "qrcode": "^1.5.4"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
